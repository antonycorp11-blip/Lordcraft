// Deploy no Cloudflare: publica a pasta dist (gerada por `npm run build`) como site estático.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lordcraft",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
